class BinaryTree19 {
    boolean isBalanced(Node root) {
        return check(root) != -1;
    }
    int check(Node root) {
        if (root == null) return 0;
        int lh = check(root.left);
        int rh = check(root.right);
        if (lh == -1 || rh == -1 || Math.abs(lh - rh) > 1) return -1;
        return 1 + Math.max(lh, rh);
    }
}
